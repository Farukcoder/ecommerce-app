APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ecommerce_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Setup seed user credentials for local development. Do not commit real passwords.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=password
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=password


VITE_APP_NAME="${APP_NAME}"

# TYRO LOGIN

TYRO_LOGIN_LAYOUT="split-left"
TYRO_LOGIN_BACKGROUND_IMAGE="https://images.unsplash.com/photo-1478760329108-5c3ed9d495a0?q=80&w=1074&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"


TYRO_LOGIN_REDIRECT_AFTER_LOGIN="/dashboard"
TYRO_LOGIN_REDIRECT_AFTER_REGISTER="/login"
TYRO_LOGIN_REDIRECT_AFTER_EMAIL_VERIFICATION="/dashboard"

TYRO_LOGIN_CAPTCHA_LOGIN="true"
TYRO_DASHBOARD_BRANDING_SIDEBAR_ACCORDION_COMPACT=false
TYRO_DASHBOARD_APP_NAME="Nityodiner Kutir"
TYRO_DASHBOARD_SIDEBAR_BG="#414143"
TYRO_DASHBOARD_SIDEBAR_TEXT="#f8fafc"
TYRO_DASHBOARD_SIDEBAR_PRIMARY="#48dcc0"
TYRO_DASHBOARD_SIDEBAR_ACCENT="#5a5a5c"
TYRO_DASHBOARD_SIDEBAR_ACCENT_FOREGROUND="#f8fafc"
TYRO_DASHBOARD_SIDEBAR_HEADER_BORDER="#5a5a5c"
TYRO_DASHBOARD_DISABLE_EXAMPLES="true"
TYRO_DASHBOARD_ENABLE_PROFILE_PHOTO="true"
TYRO_LOGIN_PASSWORD_MAX_LENGTH="30"
TYRO_LOGIN_PASSWORD_REQUIRE_NUMBERS="true"
TYRO_LOGIN_PASSWORD_REQUIRE_SPECIAL_CHARS="true"
TYRO_LOGIN_PASSWORD_CHECK_COMMON="true"
TYRO_LOGIN_SHOW_ATTEMPTS_LEFT="true"
DELETE_PREVIOUS_ACCESS_TOKENS_ON_LOGIN="true"
TYRO_DISABLE_API="true"
TYRO_DISABLE_COMMANDS="true"
TYRO_LOGIN_REGISTRATION_ENABLED="false"
TYRO_LOGIN_SOCIAL_AUTO_REGISTER="false"
TYRO_LOGIN_EMAIL_OTP="false"
TYRO_LOGIN_EMAIL_VERIFY="false"
TYRO_LOGIN_EMAIL_WELCOME="false"
TYRO_LOGIN_EMAIL_MAGIC_LINK="false"
TYRO_DASHBOARD_ENABLE_INVITATION="false"
TYRO_DASHBOARD_ADMIN_BAR_ENABLED="true"
TYRO_DASHBOARD_COLLAPSIBLE_SIDEBAR="false"
TYRO_DASHBOARD_SIDEBAR_ACCORDION_COMPACT="true"
TYRO_DASHBOARD_SIDEBAR_ACCORDION_OPEN_SECTIONS="3"
